{
  "manifest_version": 3,
  "name": "Vietnamese ChromeOS TTS Bridge",
  "version": "1.1.1",
  "description": "Cầu nối để web DOCX Reader dùng voice ChromeOS tiếng Việt.",
  "key": "",
  "permissions": ["tts"],
  "background": { "service_worker": "tts-background.js" },
  "content_scripts": [{
    "matches": ["https://*.vercel.app/*", "http://127.0.0.1/*"],
    "js": ["tts-bridge.js"],
    "run_at": "document_start"
  }],
  "externally_connectable": {
    "matches": ["https://*.vercel.app/*", "http://127.0.0.1/*"]
  }
}
